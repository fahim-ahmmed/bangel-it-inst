# MongoDB (REQUIRED - put your connection string here)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bengal_institute

# Better Auth (students)
BETTER_AUTH_SECRET=replace_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin login (/admin/login). No admin registration exists - these are the only admin credentials.
ADMIN_EMAIL=admin@bengalinstitute.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Google OAuth (optional: student Google login + Drive/Sheets/Docs portal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: enables AI image editing in /ai-studio
GEMINI_API_KEY=
